# Generated automatically by `python3 scripts/manage.py init` if absent.
# Put runtime configuration here, never management API tokens or passwords.
COMPOSE_PROJECT_NAME=anime-stack
PUID=1000
PGID=1000
TZ=Etc/UTC
# Absolute paths or paths relative to this repository. No shell expansion.
DATA_DIR=./runtime
MEDIA_DIR=./runtime/media
# Admin ports bind only to the server's loopback interface.
QB_WEB_PORT=8080
AB_WEB_PORT=7892
PEER_PORT=50888
# Use a non-overlapping RFC1918 subnet; change all addresses together.
NETWORK_SUBNET=172.28.100.0/24
QB_ADDRESS=172.28.100.2
AB_ADDRESS=172.28.100.3
PROXY_ADDRESS=172.28.100.4
# Optional public hostnames. These do not create DNS or enable a tunnel.
QB_PUBLIC_HOST=
AB_PUBLIC_HOST=
